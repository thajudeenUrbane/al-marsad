{
  "_comment": "Shared by ask/*.py and ask/static/ask.js (embedded in the browser index). Regexes use only constructs that behave the same in Python re and JavaScript RegExp: no \\b, no \\w, no named groups. Questions are lower-cased and folded before matching; refusal patterns run on the question padded with one space at each end.",

  "normalise": {
    "drop_chars": "\ufdfa\ufdfb\u0640\u200b\u200e\u200f",
    "spaces": "[\\t\\n\\u000b\\f\\r \\u001c-\\u001f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]+",
    "arabic_map": [["أ", "ا"], ["إ", "ا"], ["آ", "ا"], ["ٱ", "ا"], ["ة", "ه"], ["ى", "ي"]],
    "punct_map": [["“", "\""], ["”", "\""], ["–", "-"], ["—", "-"], [" ", " "]],
    "honorific_paren": "\\((?:pbuh|p\\.b\\.u\\.h\\.?|saw|saws|s\\.a\\.w\\.?|sas|ra|r\\.a\\.?|as|a\\.s\\.?|peace be upon him|peace and blessings be upon him)\\)",
    "possessive": "'s(?=[^a-z0-9]|$)",
    "article": "(^|[^a-z0-9])(?:al|el|as|ash|ar|at|ad|adh|an|az|ath|ul)-",
    "nonword": "[^a-z0-9؀-ۿ]+",
    "token_map": {"ibn": "b", "bin": "b", "b": "b", "bint": "bint", "bt": "bint", "abi": "abu", "aba": "abu", "al": "", "el": "", "the": ""},
    "allah_heads": ["abd", "ubayd", "ubaid"],
    "allah_tails": ["allah", "ullah", "illah", "allaah"],
    "arabic_article": "ال",
    "phonetic_multi": [["ee", "i"], ["oo", "u"], ["ou", "u"], ["ay", "ai"], ["aw", "au"], ["ph", "f"]],
    "phonetic_single": [["e", "a"], ["o", "u"], ["c", "k"], ["q", "k"]]
  },

  "cleanup": {
    "trailing": "[ ?.!]+$",
    "fillers": "^(?:please |pls |can you |could you |would you |will you |kindly |i want to know |i would like to know |i'd like to know |do you know |tell me |show me |list |give me |find |search for |search |look up )+"
  },

  "status_suffix": [
    "^(.+?),? (?:with )?(?:only )?(?:reviewed|accepted|verified|scholar-reviewed|scholar reviewed|checked) (?:claims |records )?only$",
    "^(.+?),? (?:only )?(?:counting|using|from) (?:only )?(?:reviewed|accepted|verified) (?:claims|records)$",
    "^(?:only )?(?:reviewed|accepted|verified) (?:claims|records)(?: only)?[:,]? (.+)$"
  ],

  "time": {
    "range": "^(.+?),? (?:between|from) (?:the years? )?(\\d{1,4}) ?(ah|ce|ad|bh|bce)?(?: (?:and|to|until|till) | ?- ?)(\\d{1,4}) ?(ah|ce|ad|bh|bce)?$",
    "single": "^(.+?),? (?:in|during) (?:the year )?(\\d{1,4}) ?(ah|ce|ad|bh|bce)$",
    "single_bare": "^(.+?),? (?:in|during) (?:the year )?(\\d{3,4})$",
    "max_ah": 1500,
    "min_ce": 500,
    "max_ce": 2100,
    "bare_ah_max": 200
  },

  "dsl_direct": "^[a-z_]+ ?\\(",

  "refusals": [
    {"class": "fabrication", "patterns": [
      " (?:write|compose|generate|create|make up|invent|fabricate|draft|produce|forge) (?:me |us )?(?:a |an |some |the |one |new |short |fake |original )*(?:hadith|hadiths|ahadith|narration|narrations|saying|sayings|report|reports|quote|quotes|quotation|verse|verses|ayah|ayat|surah|dua|supplication|sermon|khutbah|chain|isnad)(?: |$)",
      " (?:write|compose|generate|create|make up|invent|fabricate|forge) .*(?:hadith|narration|isnad|saying of the prophet|quote from the prophet|words of the prophet)",
      " (?:write|compose|generate|create|make up|invent|draft) (?:me |us )?(?:a |an |some |the |new |short )*(?:story|stories|tale|tales|poem|poems|biography|account|narrative) (?:about|of|on|for) "
    ]},
    {"class": "depiction", "unless": " (?:map|maps|route|routes|graph|network|chart|timeline|diagram|family tree|table) ", "patterns": [
      " (?:image|images|picture|pictures|pic|pics|photo|photos|photograph|photographs|portrait|portraits|drawing|drawings|painting|paintings|sketch|sketches|illustration|illustrations|depiction|depictions|statue|statues|avatar|likeness|cartoon|cartoons|animation|3d model|selfie) ",
      " (?:draw|paint|sketch|illustrate|depict|animate|render|visualise|visualize) ",
      " (?:look|looked|looks) like ",
      " (?:his|her|their) (?:face|faces|appearance|features|complexion) ",
      " (?:face|appearance|complexion) of "
    ]},
    {"class": "grading", "patterns": [
      " (?:authentic|authenticity|sahih|saheeh|da'?if|daeef|weak|fabricated|forged|mawdu'?|hasan|graded|grading|grade|reliable|unreliable|trustworthy|sound) (?:hadith|hadiths|narration|narrations|report|reports|chain|chains|isnad|tradition|traditions)",
      " (?:hadith|hadiths|narration|narrations|report|reports|isnad|tradition|traditions) .*(?:authentic|sahih|saheeh|da'?if|weak|fabricated|forged|mawdu'?|hasan|reliable|trustworthy|sound|true|real|correct|graded|grade)(?: |$)",
      " (?:is|are|was|were) (?:the |this |that |these |those )?(?:hadith|hadiths|narration|narrations|report|reports|story|stories|chain|isnad) (?:of [a-z' -]+ )?(?:authentic|true|real|reliable|sahih|correct|weak|fabricated|forged|sound)",
      " (?:grade|authenticate|verify the hadith|check the authenticity of|how strong is|how authentic is) "
    ]},
    {"class": "interpretation", "patterns": [
      " (?:meaning|meanings|interpretation|interpretations|tafsir|tafseer|exegesis|explanation|explain|interpret|lesson|lessons|moral|wisdom) (?:of |behind |in |from )?(?:this |that |the |a )?(?:verse|verses|ayah|ayat|aya|surah|sura|surat|quran|qur'an|koran|hadith|hadiths|scripture|revelation|revelations)",
      " (?:verse|verses|ayah|ayat|aya|surah|sura|surat|quran|qur'an|koran|scripture) .*(?:mean|means|meant|meaning|teach|teaches|interpret|interpreted|signify|signifies|symbolise|symbolize)(?: |$)",
      " what (?:does|did|is) (?:allah|god) (?:mean|meant|saying|say) ",
      " what (?:is|was|are|were) the (?:lesson|lessons|moral|morals|wisdom) (?:of|from|behind|in) "
    ]},
    {"class": "ruling", "patterns": [
      " (?:fatwa|fatwas|fatawa|fatwah|ruling|rulings|hukm|ahkam) ",
      " (?:halal|haram|makruh|makrooh|mustahab|mustahabb|wajib|fard|mubah|bid'?ah|bid'a|bidah|shirk) ",
      " is it (?:allowed|permissible|permitted|impermissible|forbidden|lawful|unlawful|prohibited|obligatory|mandatory|sinful|a sin|recommended|ok|okay|fine) ",
      " (?:allowed|permissible|permitted|forbidden|lawful|unlawful|prohibited|obligatory|mandatory|sinful) (?:in islam|for muslims|for a muslim|for me|for us|for women|for men) ",
      " (?:can|may|should|must|shall|could) (?:i|we|a muslim|muslims|women|men|a woman|a man|one) (?:eat|drink|pray|marry|wear|listen|celebrate|fast|touch|shake hands|shave|dye|pluck|smoke|gamble|divorce|tattoo|pierce|sing|dance|combine|delay|miss|break|pay|take interest|charge interest|buy|sell|trim|grow|cut|keep a dog|keep dogs|own|bet|lend|borrow|invest|work|vote|perform|recite) ",
      " what (?:does|do|did) (?:islam|the quran|the qur'an|the sunnah|sharia|shariah|the sharia|the shariah|the scholars|scholars|the madhhab|the madhhabs) (?:say|says|teach|teaches|rule|hold) ",
      " (?:islamic|religious) (?:view|position|stance|perspective|opinion) (?:on|about|of) "
    ]},
    {"class": "judgement", "patterns": [
      " (?:was|is|were|are) .*(?:a |an )?(?:hypocrite|hypocrites|munafiq|munafiqun|munafiqin|kafir|kuffar|disbeliever|disbelievers|apostate|apostates|sinner|sinners|heretic|heretics|evil|wicked|cursed|accursed|damned|traitor|traitors|bad person|good person|bad muslim|good muslim|true believer|real muslim|righteous person)(?: |$)",
      " (?:who|which people|which companions) (?:was|were|is|are) (?:the )?(?:hypocrites|munafiqun|munafiqin|traitors|disbelievers|sinners)(?: |$)",
      " (?:will|did|does|do|is|was|are|were) [a-z' -]*(?:go|went|goes|enter|entered|be|end up) (?:to |in |into )?(?:paradise|heaven|hell|jannah|jahannam|the fire|hellfire)(?: |$)",
      " (?:is|was|are|were) [a-z' -]* in (?:paradise|heaven|hell|jannah|jahannam|hellfire)(?: |$)",
      " who (?:was|is|were|are) (?:right|wrong|to blame|at fault|guilty|in the right|in the wrong)(?: |$)",
      " (?:was|is|were|are) [a-z' -]*(?:right|wrong) (?:at|in|about) (?:siffin|jamal|the fitna|fitna|the battle of the camel|the camel|karbala)",
      " (?:who|which) [a-z' -]*(?:to blame|at fault|guilty) ",
      " (?:curse|cursing|condemn|condemning|insult|insulting) "
    ]},
    {"class": "ranking", "patterns": [
      " (?:greatest|best|holiest|noblest|most important|most significant|most pious|most virtuous|most righteous|most beloved|most influential|most central|most connected|most knowledgeable|most famous|most powerful|most honoured|most honored|most excellent|most superior|most loved|most senior|most prominent|most notable|most respected|top|highest ranked|highest-ranked|superior|supreme) (?:\\d+ |ten |five |three |two )?(?:companion|companions|sahabi|sahaba|sahabah|person|people|man|men|woman|women|wife|wives|caliph|caliphs|muslim|muslims|believer|believers|scholar|scholars|narrator|narrators|leader|leaders|general|generals|fighter|fighters|warrior|warriors|member|members|figure|figures|follower|followers|human|humans|one|ones|individual|individuals|of them|of all)(?: |$)",
      " who (?:is|was|were|are) (?:the )?(?:greatest|best|holiest|noblest|most [a-z]+|superior|first among|highest)(?: |$)",
      " who (?:is|was|were|are) (?:greater|better|holier|nobler|superior|more [a-z]+)(?: |,|$)",
      " (?:rank|ranking|ranked|order|sort|list|compare|grade) (?:the |these |all )?(?:companions|sahaba|sahabah|people|caliphs|wives|men|women|narrators|scholars|persons|muslims|believers) (?:by|according to|in order of|on) ",
      " rank (?:the|these|them|all|companions|people|caliphs) ",
      " (?:better|greater|holier|nobler|superior|more important|more pious|more virtuous|more righteous|more beloved|more significant|more knowledgeable|more central|more influential|more excellent|more senior|more worthy) (?:than|or) ",
      " (?:the )?most (?:battles|events|stories|connections|links|ties|relatives|wives|children|narrations|hadith|hadiths|reports|claims|records|followers|students|appearances|mentions|virtues)(?: |$)",
      " (?:centrality|betweenness|pagerank|page rank|degree centrality|influence score|importance score|importance ranking) "
    ]},
    {"class": "speculation", "patterns": [
      " (?:probably|likely|possibly|presumably|perhaps|maybe) ",
      " (?:might|may|could|would|must) have ",
      " (?:imagine|guess|speculate|speculation|hypothetical|hypothetically|suppose|supposing|what if|fill in|fill the gap|fill the gaps|make up|invent) ",
      " what would "
    ]}
  ],

  "slots": {
    "presence": {"kinds": ["event", "place", "story"]},
    "happening_set": {"kinds": ["event", "place", "story"]},
    "happening": {"kinds": ["event", "story"]},
    "happening_or_place": {"kinds": ["event", "place", "story"]},
    "person": {"kinds": ["person"]},
    "agent": {"kinds": ["person", "group"]},
    "place": {"kinds": ["place"]},
    "story": {"kinds": ["story"]},
    "entity": {"kinds": ["person", "event", "place", "group", "story"]}
  },

  "shapes": [
    {"id": "both_presence", "dsl": "both({1}, {2})", "slots": {"1": "presence", "2": "presence"}, "patterns": [
      "^(?:who|which people|which companions|what people|which persons) (?:was|were|is|are) (?:present )?(?:at|in) both (.+?) and (?:at |in )?(.+)$",
      "^(?:who|which people|which companions) (?:fought|took part|participated|attended|was present|were present)(?: in| at)? both (.+?) and (?:in |at )?(.+)$",
      "^(?:people|companions|those) (?:who were |who was )?(?:at|in) both (.+?) and (?:at |in )?(.+)$"
    ]},
    {"id": "except_presence", "dsl": "except({1}, {2})", "slots": {"1": "presence", "2": "presence"}, "patterns": [
      "^(?:who|which people|which companions) (?:was|were) (?:present )?(?:at|in) (.+?),? but not (?:at |in )?(.+)$",
      "^(?:who|which people|which companions) (?:fought|took part|participated) (?:at|in) (.+?),? but not (?:at |in )?(.+)$"
    ]},
    {"id": "count_presence", "dsl": "count({1})", "slots": {"1": "presence"}, "patterns": [
      "^how many(?: people| persons| companions| men| women| muslims| participants)? (?:were|was|are|is) (?:there )?(?:present )?(?:at|in) (.+)$",
      "^how many(?: people| persons| companions| men| women| muslims| participants)? (?:fought|took part|participated|attended) (?:at |in )?(.+)$"
    ]},
    {"id": "absent", "dsl": "absent({1})", "slots": {"1": "happening_set"}, "patterns": [
      "^(?:who|which people|which companions) (?:was|were) (?:absent|missing|not present) (?:from|at|in) (.+)$",
      "^(?:who|which people|which companions) (?:missed|did not attend|didn't attend|did not fight at|did not fight in|didn't fight at|didn't fight in|stayed behind from|did not take part in|didn't take part in) (.+)$",
      "^(?:who|which people) (?:was not|wasn't|were not|weren't) (?:at|in) (.+)$"
    ]},
    {"id": "leaders", "dsl": "participants({1}, as: leader)", "slots": {"1": "happening_set"}, "patterns": [
      "^(?:who|which people|which companions) (?:led|commanded|headed) (?:the muslims |the army |the companions |the muslim army )?(?:at |in )?(.+)$",
      "^who (?:was|were) the (?:leader|leaders|commander|commanders) (?:of|at|in) (.+)$"
    ]},
    {"id": "story_people", "dsl": "participants({1})", "slots": {"1": "story"}, "patterns": [
      "^(?:who|which people|which companions) (?:is|are|was|were) (?:named |mentioned |listed )?in the story (?:of |about |called )?(.+)$",
      "^(?:people|companions|names) (?:in|of) the story (?:of |about |called )?(.+)$"
    ]},
    {"id": "between", "dsl": "between({1}, {2})", "slots": {"1": "agent", "2": "happening_or_place"}, "patterns": [
      "^is it true that (.+?) (?:was|were) (?:present )?(?:at|in) (.+)$",
      "^is it true that (.+?) (?:took part|fought|participated) (?:at|in) (.+)$",
      "^(?:was|were) (.+?) (?:present )?(?:at|in) (.+)$",
      "^did (.+?) (?:take part in|fight at|fight in|participate in|attend|join|go to|witness) (.+)$"
    ]},
    {"id": "children_gendered", "dsl": "relatives({1}, tie: child)", "note": "gender", "slots": {"1": "person"}, "patterns": [
      "^(?:who (?:was|were|is|are) )?(?:the )?(?:sons|son|daughters|daughter) of (.+)$",
      "^(?:who (?:was|were|is|are) )?(.+?)'s (?:sons|son|daughters|daughter)$"
    ]},
    {"id": "children", "dsl": "relatives({1}, tie: child)", "slots": {"1": "person"}, "patterns": [
      "^(?:who (?:was|were|is|are) )?(?:the )?(?:children|child|kids|offspring) of (.+)$",
      "^(?:who (?:was|were|is|are) )?(.+?)'s (?:children|child|kids|offspring)$",
      "^did (.+?) have (?:children|kids)$"
    ]},
    {"id": "father", "dsl": "relatives({1}, tie: father)", "slots": {"1": "person"}, "patterns": [
      "^(?:who (?:was|is) )?(?:the )?father of (.+)$",
      "^(?:who (?:was|is) )?(.+?)'s father$"
    ]},
    {"id": "mother", "dsl": "relatives({1}, tie: mother)", "slots": {"1": "person"}, "patterns": [
      "^(?:who (?:was|is) )?(?:the )?mother of (.+)$",
      "^(?:who (?:was|is) )?(.+?)'s mother$"
    ]},
    {"id": "parents", "dsl": "relatives({1}, tie: parent)", "slots": {"1": "person"}, "patterns": [
      "^(?:who (?:was|were|is|are) )?(?:the )?(?:parents|parent) of (.+)$",
      "^(?:who (?:was|were|is|are) )?(.+?)'s (?:parents|parent)$"
    ]},
    {"id": "spouses", "dsl": "relatives({1}, tie: spouse)", "slots": {"1": "person"}, "patterns": [
      "^(?:who (?:was|were|is|are) )?(?:the )?(?:wife|wives|husband|husbands|spouse|spouses) of (.+)$",
      "^(?:who (?:was|were|is|are) )?(.+?)'s (?:wife|wives|husband|husbands|spouse|spouses)$",
      "^(?:who|whom) did (.+?) marry$",
      "^who (?:was|were|is|are) (.+?) married to$"
    ]},
    {"id": "siblings_gendered", "dsl": "relatives({1}, tie: sibling)", "note": "gender", "slots": {"1": "person"}, "patterns": [
      "^(?:who (?:was|were|is|are) )?(?:the )?(?:brother|brothers|sister|sisters) of (.+)$",
      "^(?:who (?:was|were|is|are) )?(.+?)'s (?:brother|brothers|sister|sisters)$"
    ]},
    {"id": "siblings", "dsl": "relatives({1}, tie: sibling)", "slots": {"1": "person"}, "patterns": [
      "^(?:who (?:was|were|is|are) )?(?:the )?(?:siblings|sibling) of (.+)$",
      "^(?:who (?:was|were|is|are) )?(.+?)'s (?:siblings|sibling)$"
    ]},
    {"id": "relatives", "dsl": "relatives({1})", "slots": {"1": "person"}, "patterns": [
      "^(?:who (?:was|were|is|are) )?(?:the )?(?:relatives|relative|relations|family|family members|kin|kinsmen|kinship ties|family ties) of (.+)$",
      "^(?:who (?:was|were|is|are) )?(.+?)'s (?:relatives|relations|family|family members|kin|kinsmen|kinship ties|family ties)$",
      "^who (?:was|were|is|are) (?:related to|in the family of) (.+)$"
    ]},
    {"id": "connected_both", "dsl": "both(connected({1}), connected({2}))", "slots": {"1": "agent", "2": "agent"}, "patterns": [
      "^(?:who|which people|which companions|people who|companions who|those who) (?:met|knew|was connected to|were connected to|is connected to|are connected to|was linked to|were linked to|had ties to|had links to) both (.+?) and (.+)$",
      "^(?:people|companions) (?:connected|linked) (?:to|with) both (.+?) and (.+)$"
    ]},
    {"id": "path", "dsl": "path({1}, {2})", "slots": {"1": "entity", "2": "entity"}, "patterns": [
      "^how (?:is|was|are|were) (.+?) (?:connected|related|linked) (?:to|with) (.+)$",
      "^(?:what is |what's |what was )?(?:the )?(?:path|connection|link|chain|relation|relationship) (?:between|from) (.+?) (?:and|to) (.+)$",
      "^what (?:connects|connected|links|linked) (.+?) (?:and|to|with) (.+)$"
    ]},
    {"id": "connected", "dsl": "connected({1})", "slots": {"1": "agent"}, "patterns": [
      "^(?:who|which people|which companions) (?:was|were|is|are) (?:connected|linked|close) to (.+)$",
      "^(?:who|which people|which companions) (?:met|knew) (.+)$",
      "^(?:people|everyone|companions|those) (?:connected|linked) (?:to|with) (.+)$",
      "^(?:connections|ties|links|network) (?:of|for) (.+)$",
      "^(.+?)'s (?:connections|ties|links|network)$"
    ]},
    {"id": "events_place", "dsl": "events(at: {1}{time})", "slots": {"1": "place"}, "patterns": [
      "^(?:what|which) (?:events|battles|incidents|expeditions|things|campaigns) (?:happened|took place|occurred|are recorded|were recorded|were there|are there)? ?(?:at|in) (.+)$",
      "^what (?:happened|took place|occurred) (?:at|in) (.+)$",
      "^(?:events|battles|incidents|expeditions) (?:at|in) (.+)$"
    ]},
    {"id": "events_agent", "dsl": "events(involving: {1}{time})", "slots": {"1": "agent"}, "patterns": [
      "^(?:what|which) (?:events|battles|incidents|expeditions|campaigns) (?:was|were|did) (.+?) (?:in|at|part of|take part in|participate in|attend|fight in|fight at|present at|join|involved in)$",
      "^(?:what|which) (?:events|battles|incidents|expeditions|campaigns) (?:involved|included|featured) (.+)$",
      "^(?:events|battles|incidents|expeditions) (?:of|with|involving|for|featuring) (.+)$",
      "^what did (.+?) (?:take part in|participate in|attend|fight in)$"
    ]},
    {"id": "events_time", "dsl": "events({time})", "needs_time": true, "slots": {}, "patterns": [
      "^(?:what|which) (?:events|battles|incidents|expeditions|things|campaigns)(?: happened| took place| occurred| are recorded| were recorded| were there| are there)?$",
      "^what (?:happened|took place|occurred)$",
      "^(?:events|battles|incidents|expeditions)$"
    ]},
    {"id": "stories_of", "dsl": "stories(involving: {1})", "slots": {"1": "agent"}, "patterns": [
      "^(?:which|what) stories (?:mention|mentions|name|names|include|includes|feature|features|involve|involves|are about|tell of|tell about|talk about|have) (.+)$",
      "^(?:in )?(?:which|what) stories (?:does|do|is|are) (.+?) (?:appear|appear in|named|named in|mentioned|mentioned in|feature|featured)$",
      "^stories (?:about|with|of|mentioning|naming|involving|featuring) (.+)$",
      "^(?:a |the )?(?:story|stories) (?:about|of) (.+)$"
    ]},
    {"id": "when_died", "dsl": "when({1})", "slots": {"1": "person"}, "patterns": [
      "^when did (.+?) die$",
      "^(?:what is |what was )?(?:the )?(?:date|year) of (.+?)'s death$",
      "^(?:what is |what was )?(?:the )?(?:date|year) of (?:the )?death of (.+)$"
    ]},
    {"id": "when", "dsl": "when({1})", "slots": {"1": "happening"}, "patterns": [
      "^when (?:was|were|did|is) (.+?)(?: happen| take place| occur| fought| held| start| begin)?$",
      "^(?:what is |what was )?(?:the )?date of (.+)$",
      "^(?:what|which) year (?:was|did|is) (.+?)(?: happen| take place| occur)?$"
    ]},
    {"id": "where", "dsl": "where({1})", "slots": {"1": "happening"}, "patterns": [
      "^where (?:was|were|did|is) (.+?)(?: happen| take place| occur| fought| held| located)?$",
