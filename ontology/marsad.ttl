mrs:gb_inferred a mrs:GeometryBasis ; skos:prefLabel "inferred"@en .
mrs:gb_modern_identification a mrs:GeometryBasis ; skos:prefLabel "modern identification"@en .

mrs:CompanionStatus a owl:Class ; rdfs:subClassOf skos:Concept ;
