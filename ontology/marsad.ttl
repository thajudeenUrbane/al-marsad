mrs:con_mudal a mrs:Continuity ; skos:prefLabel "mu‘ḍal"@en .
mrs:con_muallaq a mrs:Continuity ; skos:prefLabel "mu‘allaq"@en .
mrs:con_mursal a mrs:Continuity ; skos:prefLabel "mursal"@en .

mrs:TransmissionMode a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:tm_sama a mrs:TransmissionMode ; skos:prefLabel "samā‘"@en .
mrs:tm_qiraa a mrs:TransmissionMode ; skos:prefLabel "qirā’a"@en .
mrs:tm_ijaza a mrs:TransmissionMode ; skos:prefLabel "ijāza"@en .
mrs:tm_munawala a mrs:TransmissionMode ; skos:prefLabel "munāwala"@en .
mrs:tm_wijada a mrs:TransmissionMode ; skos:prefLabel "wijāda"@en .
mrs:tm_anana a mrs:TransmissionMode ; skos:prefLabel "‘an‘ana"@en .
mrs:tm_unspecified a mrs:TransmissionMode ; skos:prefLabel "unspecified"@en .

mrs:Tabaqa a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:comment "Flat in v0.1; the classical tabaqat works subdivide considerably. See docs/02 §14.5."@en .
mrs:tb_sahabi a mrs:Tabaqa ; skos:prefLabel "ṣaḥābī"@en .
mrs:tb_tabii a mrs:Tabaqa ; skos:prefLabel "tābi‘ī"@en .
mrs:tb_tabi_al_tabiin a mrs:Tabaqa ; skos:prefLabel "tābi‘ al-tābi‘īn"@en .
mrs:tb_unclassified a mrs:Tabaqa ; skos:prefLabel "unclassified"@en .

mrs:ReportGenre a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:rg_hadith a mrs:ReportGenre ; skos:prefLabel "ḥadīth"@en .
mrs:rg_sira_maghazi a mrs:ReportGenre ; skos:prefLabel "sīra / maghāzī"@en ;
    skos:note "Hadith grading vocabulary does not apply by default to this genre."@en .
mrs:rg_tabaqat a mrs:ReportGenre ; skos:prefLabel "ṭabaqāt"@en .
mrs:rg_tarikh a mrs:ReportGenre ; skos:prefLabel "tārīkh"@en .
mrs:rg_adab a mrs:ReportGenre ; skos:prefLabel "adab"@en .
mrs:rg_other a mrs:ReportGenre ; skos:prefLabel "other"@en .

mrs:ConfidenceBand a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:cb_attested a mrs:ConfidenceBand ; skos:prefLabel "attested"@en .
mrs:cb_well_attested a mrs:ConfidenceBand ; skos:prefLabel "well attested"@en .
mrs:cb_classical_report a mrs:ConfidenceBand ; skos:prefLabel "classical report"@en ;
    skos:note "Transmitted in the historical tradition without hadith-grade evaluation. Neither dismissed nor elevated."@en .
mrs:cb_contested a mrs:ConfidenceBand ; skos:prefLabel "contested"@en .
mrs:cb_weakly_attested a mrs:ConfidenceBand ; skos:prefLabel "weakly attested"@en .
mrs:cb_unattested a mrs:ConfidenceBand ; skos:prefLabel "unattested"@en .

mrs:Significance a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:sig_factual a mrs:Significance ; skos:prefLabel "factual"@en .
mrs:sig_chronological a mrs:Significance ; skos:prefLabel "chronological"@en .
mrs:sig_interpretive a mrs:Significance ; skos:prefLabel "interpretive"@en .
mrs:sig_juristic a mrs:Significance ; skos:prefLabel "juristic"@en ;
    skos:note "No computed weighting. No default position."@en .
mrs:sig_theological a mrs:Significance ; skos:prefLabel "theological"@en ;
    skos:note "No computation, no default, no ranking. The system declines to adjudicate."@en .

mrs:GapCause a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:gc_not_yet_ingested a mrs:GapCause ; skos:prefLabel "not yet ingested"@en .
mrs:gc_sources_lost a mrs:GapCause ; skos:prefLabel "sources lost"@en .
mrs:gc_sources_unavailable a mrs:GapCause ; skos:prefLabel "sources unavailable"@en .
mrs:gc_sources_unlicensed a mrs:GapCause ; skos:prefLabel "sources exist but unlicensed"@en .
mrs:gc_genuinely_unattested a mrs:GapCause ; skos:prefLabel "genuinely unattested"@en .

mrs:SegmentConfidence a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:sc_attested a mrs:SegmentConfidence ; skos:prefLabel "attested"@en .
mrs:sc_probable a mrs:SegmentConfidence ; skos:prefLabel "probable"@en .
mrs:sc_conjectural a mrs:SegmentConfidence ; skos:prefLabel "conjectural"@en .
mrs:sc_unknown a mrs:SegmentConfidence ; skos:prefLabel "unknown"@en ;
    skos:note "Renders as a break. Implementations MUST NOT interpolate across it."@en .

mrs:LocationConfidence a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:lc_certain a mrs:LocationConfidence ; skos:prefLabel "certain"@en .
mrs:lc_probable a mrs:LocationConfidence ; skos:prefLabel "probable"@en .
mrs:lc_approximate a mrs:LocationConfidence ; skos:prefLabel "approximate"@en .
mrs:lc_disputed a mrs:LocationConfidence ; skos:prefLabel "disputed"@en .
mrs:lc_unlocated a mrs:LocationConfidence ; skos:prefLabel "unlocated"@en ;
    skos:note "Valid and common. Many classical toponyms are named but not securely identified."@en .

mrs:AssertionStatus a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:as_proposed a mrs:AssertionStatus ; skos:prefLabel "proposed"@en .
mrs:as_under_review a mrs:AssertionStatus ; skos:prefLabel "under review"@en .
mrs:as_accepted a mrs:AssertionStatus ; skos:prefLabel "accepted"@en .
mrs:as_rejected a mrs:AssertionStatus ; skos:prefLabel "rejected"@en .
mrs:as_superseded a mrs:AssertionStatus ; skos:prefLabel "superseded"@en .

mrs:ReviewOutcome a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:ro_accept a mrs:ReviewOutcome ; skos:prefLabel "accept"@en ;
    skos:note "Sets the claim's status to accepted."@en .
mrs:ro_reject a mrs:ReviewOutcome ; skos:prefLabel "reject"@en ;
    skos:note "Sets the claim's status to rejected."@en .
mrs:ro_needs_discussion a mrs:ReviewOutcome ; skos:prefLabel "needs discussion"@en ;
    skos:note "Sets the claim's status to under review and refers it to the review board."@en .

mrs:ReviewCheck a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:comment "The four things a reviewer checks (maintainer, 15 October 2026)."@en .
mrs:rc_report_in_source a mrs:ReviewCheck ; skos:prefLabel "the report exists in the source"@en .
mrs:rc_chain_sound a mrs:ReviewCheck ; skos:prefLabel "the chain is sound"@en .
mrs:rc_summary_fair a mrs:ReviewCheck ; skos:prefLabel "the summary is fair"@en .
mrs:rc_identity a mrs:ReviewCheck ; skos:prefLabel "who is who"@en .

# The first review board's lens: the system's declared default (slice 3a).
mrs:tradition_first_board a mrs:Tradition ;
    rdfs:label "The first review board's lens (declared default)"@en ;
    skos:prefLabel "Sunni, across the four madhhabs, coordinated initially by Shāfiʿī scholars"@en ;
    mrs:declaredDefault true ;
    rdfs:comment """The lens of the first review board and the system's DECLARED
        DEFAULT. The maintainer (15 October 2026): "One board first (Sunni,
        across the four madhhabs, coordinated initially by Shāfiʿī scholars);
        others later." This narrows docs/06 §9 principle 1 (a cross-tradition
        board) for the first release and is stated publicly as a declared
        default. It is one lens among several, not a neutral view: no
        tradition in this corpus is presented as neutral (docs/06 §2.3)."""@en .

mrs:CheckResult a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:chk_plausible a mrs:CheckResult ; skos:prefLabel "plausible"@en .
mrs:chk_implausible a mrs:CheckResult ; skos:prefLabel "implausible"@en .
mrs:chk_indeterminate a mrs:CheckResult ; skos:prefLabel "indeterminate"@en .

