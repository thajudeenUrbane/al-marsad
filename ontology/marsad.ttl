mrs:cal_hijri a mrs:Calendar ; skos:prefLabel "hijrī"@en .
mrs:cal_julian a mrs:Calendar ; skos:prefLabel "Julian"@en .
mrs:cal_gregorian a mrs:Calendar ; skos:prefLabel "Gregorian"@en .

mrs:Precision a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:pr_day a mrs:Precision ; skos:prefLabel "day"@en .
mrs:pr_month a mrs:Precision ; skos:prefLabel "month"@en .
mrs:pr_year a mrs:Precision ; skos:prefLabel "year"@en .
mrs:pr_decade a mrs:Precision ; skos:prefLabel "decade"@en .
mrs:pr_generation a mrs:Precision ; skos:prefLabel "generation"@en .
mrs:pr_period a mrs:Precision ; skos:prefLabel "period"@en .
mrs:pr_unknown a mrs:Precision ; skos:prefLabel "unknown"@en .

mrs:TemporalBasis a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:tbas_attested a mrs:TemporalBasis ; skos:prefLabel "attested"@en .
mrs:tbas_inferred a mrs:TemporalBasis ; skos:prefLabel "inferred"@en .
mrs:tbas_computed a mrs:TemporalBasis ; skos:prefLabel "computed"@en .
mrs:tbas_conventional a mrs:TemporalBasis ; skos:prefLabel "conventional"@en .
mrs:tbas_disputed a mrs:TemporalBasis ; skos:prefLabel "disputed"@en .

mrs:NisbaType a owl:Class ; rdfs:subClassOf skos:Concept .
mrs:nt_tribal a mrs:NisbaType ; skos:prefLabel "tribal"@en .
mrs:nt_geographic a mrs:NisbaType ; skos:prefLabel "geographic"@en .
