mrs:nt_doctrinal a mrs:NisbaType ; skos:prefLabel "doctrinal"@en .
mrs:nt_patronal a mrs:NisbaType ; skos:prefLabel "patronal"@en .

mrs:GeometryBasis a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:comment "How a location came to be identified. A map must be able to render 'traditional' differently from 'archaeological'."@en .
mrs:gb_archaeological a mrs:GeometryBasis ; skos:prefLabel "archaeological"@en .
mrs:gb_textual a mrs:GeometryBasis ; skos:prefLabel "textual"@en .
