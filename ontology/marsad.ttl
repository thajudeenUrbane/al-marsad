#################################################################
#  RESERVED — URIs minted, definitions deferred to a later version.
#  Reserving prevents future collision; specifying now would mean
#  specifying things nobody will implement for two years.
#################################################################

mrs:Institution a owl:Class ; owl:deprecated false ; rdfs:comment "RESERVED — not specified in v0.1."@en .
mrs:Dynasty a owl:Class ; rdfs:comment "RESERVED — not specified in v0.1."@en .
