    mrs:sourceDate tmp:YezEHJYOELI5ffHCKk0cVq ;
    rdfs:comment "Chain not modelled: it ends in unnamed Companions ('men of my people'). The report does not name Quba'; its link to the arrival at Quba' rests on context (the narrators' people, Banu 'Amr b. 'Awf)."@en ;
    mrs:asserts ast:JHiLe9kqlwnNCsLoDzXvmU ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:tcCkInIropKEmSqn1NHNv0 ;
