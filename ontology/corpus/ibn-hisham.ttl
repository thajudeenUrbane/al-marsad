rpt:XZTt4OzGlZqdYETJ7VQekj
    a mrs:Report ;
    rdfs:label "The arrival among Banu 'Amr b. 'Awf: Abu Bakr of about the Prophet's age"@en ;
    mrs:matnText "[Arabic text not reproduced: the source text is licensed CC BY-NC-SA 4.0, which this corpus (CC BY-SA 4.0) cannot carry. The report is located by its passage (mrs:locatedIn): its citation gives the page, OpenITI milestone, lines and characters. `python ingest/ibn_hisham.py fetch` downloads the text and `review` shows it beside each claim.]"@en ;
    crm:P3_has_note "قال ابن إسحاق: فحدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، عن عبد الرحمن بن عويمر بن ساعدة، قال: حدثني رجال من قومي من أصحاب رسول الله صلى الله عليه وسلم، قالوا:"@ar ;
    mrs:terminalAscription mrs:asc_mawquf ;
