#################################################################
#
#  IBN HISHAM, al-Sira al-Nabawiyya -- AI-assisted extraction (slice 4)
#
#  /!\  AI-EXTRACTED. PROPOSED. NOT SCHOLAR-REVIEWED.
#
#  GENERATED by ingest/ibn_hisham.py from the cached OpenITI text and
#  ingest/claims/*.jsonl, resolving every person, place and event
#  through ontology/corpus/identity.csv by name. Do not edit by hand:
#  change the claims and re-run `ingest/ibn_hisham.py build`.
#
#  SOURCE. OpenITI version 0213IbnHisham.SiraNabawiyya.Shamela0023833-ara1 (OpenITI primary version;
#  file at commit 2cfdc8cf of github.com/OpenITI/0225AH,
#  sha256 8e0d274c7bf5433d...). Its metadata names its base edition:
#  ed. Mustafa al-Saqqa, Ibrahim al-Abyari, Abd al-Hafiz Shalabi,
#  2nd ed., 1375 AH / 1955 CE, Mustafa al-Babi al-Halabi, Cairo.
#  THAT EDITION IS PROVISIONAL: the scholars will choose the edition
#  of record (maintainer decision E33). Page numbers below are that
#  edition's, as the OpenITI file marks them, not checked in print.
#
#  LICENCE. The OpenITI corpus is released under CC BY-NC-SA 4.0
#  (NonCommercial), which this corpus (CC BY-SA 4.0) cannot carry.
#  So the Arabic text is NOT in this file or anywhere in the repo.
#  Each Report says where its text is (its Passage: character
#  offsets into the file, lines, milestone, page) instead of quoting
#  it; `ingest/ibn_hisham.py fetch` downloads the file locally and
#  `review` shows every claim beside its Arabic span. Taken from the
#  text verbatim here are only: names, ascription formulas and
#  chains, and the short age and date expressions claims rest on.
#
#  WHAT A CLAIM IS. One mrs:Assertion per claim, status proposed,
#  coverage stub, created by the software agent "AI extraction pass
#  (slice 4)" on 15 October 2026, with NO adjudicator. Each one has
#  mrs:fromReport (the report it comes from), prov:wasDerivedFrom
#  (its passage) and oa:hasTarget: a W3C Web Annotation
#  TextPositionSelector giving the exact span inside the passage
#  ([start, end) in Unicode code points). rdfs:comment holds an
#  English gloss written by the AI pass: proposed, unreviewed, never
#  a translation of record (maintainer decision E34).
#
#  ASCRIPTIONS AND CHAINS. A report's ascription formula ("qala Ibn
#  Ishaq") is kept exactly as written in crm:P3_has_note and is never
#  completed: a bare "qala" stays bare, and the implied link from Ibn
#  Ishaq to Ibn Hisham is not added where the text does not write it.
#  A chain (mrs:TransmissionChain) is modelled only where the text
#  names every narrator; its label is the chain as written. The
#  transmission mode is read off the term the text uses (haddathani,
#  haddathana, sami'tu -> sama; 'an -> 'an'ana; anything else ->
#  unspecified), and each link keeps that term as its label.
#  mrs:continuity is never set: that is a scholar's determination.
#  mrs:terminalAscription is a proposed formal reading of the last
#  authority the text names (the compiler himself -> other; no
#  formula in the passage -> none; a Companion -> mawquf), for a
#  scholar to confirm. No grading of any kind is made.
#
#  LIFE DATES AND AGES (for the lifelines view). Ages are kept as
#  written (mrs:ageAsWritten) with the number the text gives
#  (mrs:ageYearsAsGiven, one value per alternative), never computed
#  and never converted: classical ages are usually lunar-year counts
#  and no passage here states its basis, so none is recorded. Dates
#  are kept as written (mrs:rel_dated, mrs:dateAsWritten); nothing is
#  converted to the Gregorian calendar.
#
#  ENTITIES. People, places and events already in identity.csv are
#  only referenced, never redeclared, with one exception: a person
#  already in the graph who is a narrator in a modelled chain is
#  typed here with the name form attested in this text, so that this
#  file validates on its own. New ones are declared below with the
#  name as written, and have identity.csv rows marked needs-review.
#  Nobody is merged or split.
#
#################################################################

agt:tcCkInIropKEmSqn1NHNv0
    a prov:SoftwareAgent ;
    rdfs:label "AI extraction pass (slice 4)"@en ;
    rdfs:comment "A generic software agent: the AI-assisted extraction pass of slice 4, run on 15 October 2026, which read passages of Ibn Hisham's Sira in the OpenITI text and proposed reports, chains and claims with their exact spans. Every claim it made is proposed and unreviewed; its English glosses are machine-written and are not translations. Which system ran the pass is deliberately not recorded in the repository."@en .

# The extraction run. NO adjudicator association: nothing below has been reviewed.
act:oxNGDz9lLFz8d9WV2jbxoU
    a prov:Activity ;
    rdfs:label "AI extraction pass (slice 4), 15 October 2026: Ibn Hisham, al-Sira al-Nabawiyya (OpenITI 0213IbnHisham.SiraNabawiyya.Shamela0023833-ara1)"@en ;
    prov:startedAtTime "2026-10-15T00:00:00Z"^^xsd:dateTime ;
    prov:used wit:cK15aTQy0aIt4HggLXQnS9 ;
    prov:qualifiedAssociation [ a prov:Association ;
          prov:agent agt:tcCkInIropKEmSqn1NHNv0 ;
          prov:hadRole mrs:role_extractor ] .

# THE SOURCE: Work -> Recension -> Edition -> Witness -> Passage (docs/02 §8.9).
wrk:1LoxHa4Pplj2ORVpBZBoSB
    a mrs:Work ;
    rdfs:label "The Sira of Ibn Ishaq (the work itself, known through its recensions)"@en ;
    rdfs:comment "Ibn Ishaq's biography of the Prophet (peace and blessings be upon him) as an abstract work (docs/02 §8.9). It survives here through Ibn Hisham's recension, which also contains Ibn Hisham's own additions, each marked in the text by 'qala Ibn Hisham'."@en ;
    dct:creator per:iQm0BXg0F8Orcv7LKUPVpU ;
    lrmoo:R3_is_realised_in rcn:wlpfqT7yP5YmEeefkp1hWP ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:tcCkInIropKEmSqn1NHNv0 ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

rcn:wlpfqT7yP5YmEeefkp1hWP
    a mrs:Recension ;
    rdfs:label "Ibn Hisham's recension: al-Sira al-Nabawiyya"@en ;
    rdfs:label "السيرة النبوية لابن هشام"@ar ;
    dct:identifier "0213IbnHisham.SiraNabawiyya" ;
    dct:creator per:Q6abR00ptJG2t8oqLFK2DM ;
    rdfs:comment "The source chosen by the maintainer (decision E32). The Arabic title is the one in the OpenITI file's metadata (020.BookTITLE). OpenITI's URI dates the author 213 AH; the author's death is also given as 218 AH (OpenITI author record: '0213-XXX-XX or 0218-RA2-13'). Which is right is not decided here."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:tcCkInIropKEmSqn1NHNv0 ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

# PROVISIONAL EDITION (maintainer decision E33): the scholars will specify the edition of record.
edn:6CwScPtgRXqj6bTHCD1VnE
    a mrs:Edition ;
    rdfs:label "al-Sira al-Nabawiyya li-Ibn Hisham, ed. Mustafa al-Saqqa, Ibrahim al-Abyari and Abd al-Hafiz Shalabi, 2nd edition, 1375 AH / 1955 CE (PROVISIONAL)"@en ;
    dct:bibliographicCitation "مصطفى السقا وإبراهيم الأبياري وعبد الحفيظ الشلبي ؛ الثانية، 1375هـ - 1955 م ؛ شركة مكتبة ومطبعة مصطفى البابي الحلبي وأولاده بمصر"@ar ;
    lrmoo:R4_embodies rcn:wlpfqT7yP5YmEeefkp1hWP ;
    rdfs:comment "PROVISIONAL (maintainer decision E33: the scholars will specify the edition of record). This is the base edition the OpenITI file names in its metadata (040.EdEDITOR, 041.EdNUMBER and 043.EdPUBLISHER, quoted in dct:bibliographicCitation, the three fields joined by semicolons). Volume and page numbers cited in this corpus are this edition's as the OpenITI file marks them (PageV01P158 = vol. 1, p. 158; OpenITI puts each marker at the end of its page). They have not been checked against a printed copy."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:tcCkInIropKEmSqn1NHNv0 ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

wit:cK15aTQy0aIt4HggLXQnS9
    a mrs:Witness ;
    rdfs:label "OpenITI digital text 0213IbnHisham.SiraNabawiyya.Shamela0023833-ara1 (the file at commit 2cfdc8cf of github.com/OpenITI/0225AH, 23 March 2026)"@en ;
    dct:identifier "0213IbnHisham.SiraNabawiyya.Shamela0023833-ara1" ;
    dct:source edn:6CwScPtgRXqj6bTHCD1VnE ;
    mrs:externalIdentifier "https://raw.githubusercontent.com/OpenITI/0225AH/2cfdc8cf1b89abfd15463d1c429fbb822aa5d9a5/data/0213IbnHisham/0213IbnHisham.SiraNabawiyya/0213IbnHisham.SiraNabawiyya.Shamela0023833-ara1.completed"^^xsd:anyURI ;
    dct:license <https://creativecommons.org/licenses/by-nc-sa/4.0/> ;
    dct:rights "OpenITI releases its corpus under CC BY-NC-SA 4.0 (release 2025.1.9, Zenodo doi:10.5281/zenodo.17767721, and the primary-version release, doi:10.5281/zenodo.18613982). The GitHub repository OpenITI/0225AH carries no licence file of its own. The text comes from al-Maktaba al-Shamila (book 23833), which has no open licence. NonCommercial is not compatible with al-Marsad's CC BY-SA 4.0, so the text is not redistributed here: only pointers into it."@en ;
    spdx:checksum [ a spdx:Checksum ;
          spdx:algorithm spdx:checksumAlgorithm_sha256 ;
          spdx:checksumValue "8e0d274c7bf5433d0c160aceca7e446f545be02a054035239b2dd349b5c399cd" ] ;
    dct:extent "1,537,073 Unicode code points (2,654,027 bytes, UTF-8, LF line endings, 26,205 lines); 930 OpenITI milestones; page markers vol. 1, p. 1 to vol. 2, p. 671"@en ;
    rdfs:comment "The OpenITI primary version of Ibn Hisham's Sira: the release metadata of OpenITI 2025.1.9 lists it with status 'pri', 278,907 tokens and 1,090,736 characters (OpenITI's counts), tagged PRIMARY_VERSION, CLEANED_VERSION and COMPLETED. Its version metadata names Mathew Barber as annotator and records that footnote markers and paratext were removed in the OpenITI clean operation of 2023, and a collation against http://www.worldcat.org/oclc/295009190. The file's own header gives the author's death as 213 AH (OpenITI's author record: '0213-XXX-XX or 0218-RA2-13'). Five other OpenITI versions of the same book exist (JK000797, Masaha003361Vols, ShamAY0034440, Shamela0007450, Shia003667Vols); none was used."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:tcCkInIropKEmSqn1NHNv0 ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

# When the containing work was composed (D6): every Report below points here.
tmp:YezEHJYOELI5ffHCKk0cVq
    a mrs:TemporalExtent ;
    rdfs:label "Composition of Ibn Hisham's recension: before its author's death"@en ;
    mrs:calendar mrs:cal_hijri ;
    mrs:nativeValue "before the death of Ibn Hisham, given as 213 AH or 13 Rabi' II 218 AH (OpenITI author record: '0213-XXX-XX or 0218-RA2-13')" ;
    mrs:precision mrs:pr_period ;
    mrs:temporalBasis mrs:tbas_inferred ;
    mrs:latestEnd "0834-01-15T23:59:59Z"^^xsd:dateTime ;
    mrs:conversionMethod "tabular Islamic calendar, civil epoch (1 Muharram 1 AH = 16 July 622, Julian), 30-year cycle with leap years 2, 5, 7, 10, 13, 16, 18, 21, 24, 26, 29; the last day of 218 AH as a Julian-calendar date, as elsewhere in this corpus; an upper bound only" ;
    mrs:conversionUncertaintyDays 3 .

# Qualifiers on claims (mrs:qualifier), defined by this file.

mrsv:q_editorial_brackets
    a mrs:Qualifier ;
    rdfs:label "rests on words in round brackets"@en ;
    rdfs:comment "The words the claim rests on are in round brackets in the edition, which marks words the editors supplied. Check them against the edition and its manuscripts."@en .

mrsv:q_hedged
    a mrs:Qualifier ;
    rdfs:label "hedged in the text"@en ;
    rdfs:comment "The narrator hedges the statement the claim rests on, in words such as “فيما بلغني” (so I have heard), “فيما يذكرون” (as they relate) or “زعموا” (they claim)."@en .

mrsv:q_share_not_present
    a mrs:Qualifier ;
    rdfs:label "counted at Badr without being present"@en ;
    rdfs:comment "The text lists the person among the people of Badr but says he was not there and that the Prophet ﷺ allotted him his share."@en .

mrsv:q_text_alternative
    a mrs:Qualifier ;
    rdfs:label "alternative report in the text"@en ;
    rdfs:comment "The text gives this as an alternative to another report, introduced by words such as “ويقال” (it is said) or “ويقول قائل” (someone says). The other report is a separate claim; neither is preferred here."@en .

