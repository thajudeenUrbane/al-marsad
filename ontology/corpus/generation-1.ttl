#################################################################
#
#  GENERATION 1 — the Prophet ﷺ and the Companions
#
#  /!\  AI-COMPILED. NOT SCHOLAR-VERIFIED. NOT COMPLETE.
#
#  Every Person, Event and Assertion here carries coverageState=stub
#  or outline and assertionStatus=proposed. Nothing in this file is
#  "knowledge" under this project's own rules (docs/06 §3) until a
#  credentialed reviewer adjudicates it and appends their own
#  qualifiedAssociation with prov:hadRole mrs:role_adjudicator. That
#  has not happened. Treat every claim below as a proposal, not fact.
#
#  SCOPE, DELIBERATELY BOUNDED. This is not "the Companions" — it is
#  ~35 of the most historically prominent and documentable Companions,
#  chosen to demonstrate the network's real shape: one huge, densely
#  and laterally connected generation, not a small root. The
#  Companions are estimated at well over 100,000 (Abu Zur'ah al-Razi,
#  via al-Suyuti); this file represents perhaps 0.03% of that
#  population by design, and says so explicitly in the CoverageGap at
#  the end. The second generation (Tabi'un) is deliberately deferred.
#
#  MODELLING CHOICE. Kinship and companionship ties here are modelled
#  as plain mrs:Assertion objects (predicate + subject + object),
#  NOT as full mrs:Relationship-with-facets objects. Doc 02 §5.3
#  illustrates the richer faceted pattern for a single, deeply
#  documented pair (Prophet <-> Abu Bakr); building that depth for
#  every one of ~50 ties here would be premature for a first,
#  unreviewed pass. A bare Assertion is fully valid under this
#  project's own SHACL constraints (I2) and is the honest level of
#  investment for stub-coverage data. Upgrading specific ties to full
#  Relationship objects is exactly the kind of work scholarly review
#  should drive, not something to pre-empt here.
#
#  SOURCING. Facts here are drawn from the standard sira/maghazi
#  tradition (chiefly Ibn Hisham's recension of Ibn Ishaq's Sira,
#  al-Waqidi's Kitab al-Maghazi, and Ibn Sa'd's Tabaqat al-Kubra) as
#  reflected in mainstream secondary literature, verified against
#  current web sources at compilation time rather than asserted from
#  unchecked recall (see docs, self-critique #31, for why that
#  discipline now applies here). None of it is matched to a specific
#  passage or edition — mrs:nonReportBasis says so on every Assertion.
#  That citation work is exactly what scholarly review should add.
#
#################################################################

agt:9wErT4yUmN7bVcX2zAsDfGh
    a prov:SoftwareAgent ;
    rdfs:label "Corpus compilation model, generation-1 pass"@en .

act:4bVcX7zAsD2fGhJ9kQwErTy
    a prov:Activity ;
    prov:startedAtTime "2026-09-12T00:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent agt:9wErT4yUmN7bVcX2zAsDfGh ;
        prov:hadRole mrs:role_extractor ] .
    # NO adjudicator association. See file header.


#################################################################
#  §1  THE ORIGIN
#################################################################

per:2mQ7vR9nK4pT8sY3wZ6xCe
    a mrs:Person ;
    rdfs:label "The Prophet Muḥammad (peace and blessings be upon him)"@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:9wErT4yUmN7bVcX2zAsDfGh ;
    mrs:recordedAt "2026-09-12T00:00:00Z"^^xsd:dateTime ;
    mrs:nameForm [ a mrs:ArabicNameForm ;
        mrs:ism "Muḥammad" ; mrs:nasab ( "ʿAbd Allāh" "ʿAbd al-Muṭṭalib" ) ;
        mrs:script "latn" ; mrs:transliterationScheme "IJMES" ] .
# Reused conceptually from ontology/examples/thawr.ttl but re-declared with a
# fresh, independent URI: generation-1.ttl is a self-contained corpus slice,
# not dependent on the illustrative example. Reconciling the two into one
# canonical identity is exactly the kind of IdentityAssertion work a scholar
# reviewer would do (docs/02 §3.3) -- not something this file may pre-empt.


#################################################################
#  §2  THE PLACE AND THE EVENT
#################################################################

plc:6hJkQ3wErT9yUmN5bVcXzA1
    a mrs:Place ;
    rdfs:label "Badr"@en ;
    mrs:coverageState mrs:cs_outline ;
    mrs:createdBy agt:9wErT4yUmN7bVcX2zAsDfGh ;
    mrs:recordedAt "2026-09-12T00:00:00Z"^^xsd:dateTime ;
    mrs:placeType mrs:pt_settlement ;
    mrs:namePhase [ a mrs:NamePhase ; mrs:phaseName "بدر"@ar ] ;
    mrs:geometryState [
        a mrs:GeometryState ;
        mrs:geometry [ a geo:Geometry ; geo:asWKT "POINT(38.7833 23.7833)"^^geo:wktLiteral ] ;
        mrs:locationConfidence mrs:lc_certain ;
        mrs:geometryBasis mrs:gb_modern_identification ;
        mrs:validExtent tmp:8gHjK4wErT7yUmN3bVcXzA1 ] .

tmp:8gHjK4wErT7yUmN3bVcXzA1
    a mrs:TemporalExtent ;
    mrs:calendar mrs:cal_gregorian ; mrs:nativeValue "valid from earliest attestation, open-ended" ;
    mrs:precision mrs:pr_period ; mrs:temporalBasis mrs:tbas_conventional ;
    mrs:earliestStart "0600-01-01T00:00:00Z"^^xsd:dateTime .
    # One corner only, deliberately: this expresses "known valid from at
    # least this point, no asserted end" rather than fabricating a close.

tmp:7yUmN5bVcX2zAsD8fGhJkQ1
    a mrs:TemporalExtent ;
    mrs:calendar mrs:cal_hijri ;
    mrs:nativeValue "17 Ramaḍān 2 AH" ;
    mrs:precision mrs:pr_day ;
    mrs:temporalBasis mrs:tbas_attested ;
    mrs:conversionMethod "tabular-islamic-civil" ;
    mrs:conversionUncertaintyDays 1 ;
    mrs:earliestStart "0624-03-13T00:00:00Z"^^xsd:dateTime ;
    mrs:latestEnd     "0624-03-13T23:59:59Z"^^xsd:dateTime .

ev:5rTyU9mNbV2cXzA8sDfGhJk1
    a mrs:Event ;
    rdfs:label "Battle of Badr"@en ;
    mrs:coverageState mrs:cs_outline ;
    mrs:createdBy agt:9wErT4yUmN7bVcX2zAsDfGh ;
    mrs:recordedAt "2026-09-12T00:00:00Z"^^xsd:dateTime ;
    mrs:eventPlace plc:6hJkQ3wErT9yUmN5bVcXzA1 ;
    mrs:eventTemporalExtent tmp:7yUmN5bVcX2zAsD8fGhJkQ1 ;

    # Structural membership: who was there, in what capacity. The colourful
    # specific detail (Ali's eight standard-bearers, Ubaydah's severed leg)
    # is carried on the corresponding Assertions in §3, not invented here as
    # a role vocabulary term that does not exist yet.
    mrs:hasParticipation
        [ a mrs:Participation ; mrs:participant per:2mQ7vR9nK4pT8sY3wZ6xCe ;
          mrs:participantRole mrs:role_leader ] ,                              # the Prophet ﷺ
        [ a mrs:Participation ; mrs:participant per:3jLd4kNqR7mZpW2vXcT8b1 ;
          mrs:participantRole mrs:role_leader ] ,                              # Ali — Muhajirun banner
        [ a mrs:Participation ; mrs:participant per:4tVbN6yHjM3kQ9wErZ7uXs1 ;
          mrs:participantRole mrs:role_leader ] ,                              # Hamza
        [ a mrs:Participation ; mrs:participant per:7yUmK3jHgF9dSaQ2wErT5z1 ;
          mrs:participantRole mrs:role_leader ] ,                              # Sa'd b. Mu'adh — Ansar leader
        [ a mrs:Participation ; mrs:participant per:2wErT5yUqP8pLkJ9hGfDsA1 ;
          mrs:participantRole mrs:role_leader ] ,                              # Mus'ab b. Umayr — standard
        [ a mrs:Participation ; mrs:participant per:5dFgH8jKmN2bVcX6zAqWsE1 ;
          mrs:participantRole mrs:role_leader ] ,                              # Zubayr — right flank
        [ a mrs:Participation ; mrs:participant per:6nBvCxZ4aSdF7gHjK9mQwE1 ;
          mrs:participantRole mrs:role_leader ] ,                              # Miqdad — left flank
        [ a mrs:Participation ; mrs:participant per:8sT3wY6xZc2mQ7vR9nK4pP1 ;
          mrs:participantRole mrs:role_participant ] ,                        # Abu Bakr
        [ a mrs:Participation ; mrs:participant per:9pLmK4nR8sT2wQ6vY3xZbA1 ;
          mrs:participantRole mrs:role_participant ] ,                        # Umar
        [ a mrs:Participation ; mrs:participant per:3zXcV5bNmA8sDfG2hJkLqW1 ;
          mrs:participantRole mrs:role_participant ] ,                        # Abd al-Rahman b. Awf
        [ a mrs:Participation ; mrs:participant per:9qWeR4tYuP7aSdF3gHjKzX1 ;
          mrs:participantRole mrs:role_participant ] ,                        # Sa'd b. Abi Waqqas
        [ a mrs:Participation ; mrs:participant per:7cVbN3mAsD9fGhJ4kQwErT1 ;
          mrs:participantRole mrs:role_participant ] ,                        # Abu Ubaydah b. al-Jarrah
        [ a mrs:Participation ; mrs:participant per:2aSdF6gHjK8mNbV5cXzQwE1 ;
          mrs:participantRole mrs:role_participant ] ,                        # Bilal
        [ a mrs:Participation ; mrs:participant per:4sDfG6hJkQ2wErT9yUmNbV1 ;
          mrs:participantRole mrs:role_participant ] ,                        # Ubaydah b. al-Harith — duelist
        [ a mrs:Participation ; mrs:participant per:6wErT9yUmN5bVcX2zAsDfG1 ;
          mrs:participantRole mrs:role_participant ] ,                        # Ammar b. Yasir
        [ a mrs:Participation ; mrs:participant per:2cXzA8sDfG3hJkQ6wErTyU1 ;
          mrs:participantRole mrs:role_participant ] ;                        # Abdullah b. Rawaha

    mrs:coverageGap cvg:3fGhJ5kQwE8rTyU2mNbVcX1 .
# ⟨scholar⟩ This participant list is a documentable HIGHLIGHT set, not the
# roster of 313. See the CoverageGap (§8) for what is missing and why.


#################################################################
