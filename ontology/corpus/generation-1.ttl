ast:6yUmN9bVcX4zAsD7fGhJk04 a mrs:Assertion ;
    mrs:coverageState mrs:cs_stub ; mrs:createdBy agt:9wErT4yUmN7bVcX2zAsDfGh ;
    mrs:recordedAt "2026-09-12T00:00:00Z"^^xsd:dateTime ;
