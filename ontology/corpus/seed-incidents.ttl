#################################################################
#
#  SEED INCIDENTS — a 100-item incident batch, Incident -> People ->
#  Place -> Time -> Connections -> Source, user-compiled September 2026
#  and structured into the ontology here.
#
#  /!\  UNVERIFIED SEED DATA. NOT SCHOLAR-REVIEWED. NOT AI-RESEARCHED.
#
#  PROVENANCE, IMPORTANT DISTINCTION FROM generation-1.ttl: the 100
#  incidents below were compiled and supplied directly by the project's
#  maintainer in chat, in a compact Incident/People/Place/Time/
#  Connections/Source shorthand, explicitly as seed material "for graph
#  construction, not final educational prose" and explicitly marked by
#  its author as pending scholarly review before verification. This file
#  is the mechanical encoding of that user-supplied text into the
#  ontology -- it is NOT the result of independent AI research the way
#  generation-1.ttl's compilation pass was. Every mrs:nonReportBasis
#  below is a close paraphrase of the user's own incident line, not an
#  AI-asserted historical claim. No source edition or passage has been
#  attached to any of them (mrs:nonReportBasis says so explicitly,
#  matching the seed dataset's own "Evidence: [to be attached]" and
#  "Scholarly Status: Pending review" fields).
#
#  SCOPE. This file EXTENDS the network beyond generation-1.ttl's fixed
#  35-person roster -- the user explicitly asked for that expansion here.
#  generation-1.ttl itself is untouched: its 35 Person IRIs and 6 Event
#  IRIs are REUSED below wherever an incident refers to them (so the two
#  files describe one connected graph, not two islands), and roughly 22
#  new Person entities are minted for names outside that original 35.
#
#  MODELLING CHOICE. Rather than one mrs:Event per incident number, many
#  incidents that describe the same real occasion (e.g. items 001-003,
#  all the first revelation and its immediate aftermath; items 029-034,
#  all the Hijra departure via Ghar Thawr) share ONE mrs:Event, with each
#  incident recorded as its own citable mrs:Assertion pointing at it.
#  Six incidents (041-045, 048-051, 053-054, 056, 058, 060-061, 064,
#  069-070, 086) describe facts already modelled as Participations or
#  Assertions in generation-1.ttl; those are noted as corroborating,
#  independently-recorded claims of the same fact, not merged with it --
#  merging independent claims of one fact is exactly the kind of
#  reconciliation work scholarly review should do (docs/02 SS3.3), not
#  something a compilation pass may pre-empt.
#
#  DATING. Every new mrs:TemporalExtent below uses mrs:tbas_conventional
#  and a deliberately wide corner range: these are standard, widely-cited
#  approximate CE years for each incident, NOT calendar-precise attested
#  dates. Precise dating is exactly the kind of citation work pending
#  scholarly review.
#
#################################################################

agt:kTu6mgA6KseoQsoNk4Boe1
    a prov:SoftwareAgent ;
    rdfs:label "Seed-incident structuring pass (user-supplied dataset, Sept 2026)"@en .

act:hW9XtUYqyyf8rbp9UsxhEK
    a prov:Activity ;
    prov:startedAtTime "2026-09-18T00:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent agt:kTu6mgA6KseoQsoNk4Boe1 ;
        prov:hadRole mrs:role_extractor ] .
    # NO adjudicator association -- see file header.


