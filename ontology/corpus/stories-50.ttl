ev:pH31QwYeNTRrfK9FXDbnu4
    a mrs:Event ;
    rdfs:label "The First Revelation in the Cave of Hira"@en ;
    skos:notation 1 ;
    crm:P67i_is_referred_to_by psg:AkeTzPhD65NspJqA9ID27d ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:AkeTzPhD65NspJqA9ID27d
    a mrs:Passage ;
    rdfs:label "The First Revelation in the Cave of Hira"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 1" ;
    skos:notation 1 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:pH31QwYeNTRrfK9FXDbnu4 ;
    crm:P190_has_symbolic_content """At about forty years of age, the Prophet ﷺ used to retreat to the Cave of Hira on Jabal al-Nur to worship. There the angel Jibril came to him and commanded, "Read!" He replied, "I am not a reader." After the angel pressed him three times, the first verses of Surah al-Alaq were revealed. He returned home trembling and said to Khadijah, "Cover me, cover me."

Khadijah comforted him, saying Allah would never disgrace him because he kept family ties, helped the weak, honoured guests and supported people in hardship. She took him to her cousin Waraqah ibn Nawfal, a Christian scholar, who recognised the signs of prophethood and said his people would drive him out."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:Xo2CeHC0qiLd2kA5zpDaWj
    a mrs:Event ;
    rdfs:label "The First Believers"@en ;
    skos:notation 2 ;
    crm:P67i_is_referred_to_by psg:Ybc6ss3LuwLmxBj7wVyVqt ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:Ybc6ss3LuwLmxBj7wVyVqt
    a mrs:Passage ;
    rdfs:label "The First Believers"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 2" ;
    skos:notation 2 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:Xo2CeHC0qiLd2kA5zpDaWj ;
    crm:P190_has_symbolic_content "After Khadijah, the first to accept Islam were Ali ibn Abi Talib, a boy living in the Prophet's household, Zayd ibn Harithah, his freed servant and adopted son, and Abu Bakr, his closest friend, who believed without hesitation. Abu Bakr then invited his own friends, and five of the ten promised Paradise entered Islam through him."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:EOEknED3IxvBS7bHnjBSqf
    a mrs:Event ;
    rdfs:label "The Call from Mount Safa"@en ;
    skos:notation 3 ;
    crm:P67i_is_referred_to_by psg:NZ8ieYAbpPkmdJWorOu3oR ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:NZ8ieYAbpPkmdJWorOu3oR
    a mrs:Passage ;
    rdfs:label "The Call from Mount Safa"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 3" ;
    skos:notation 3 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:EOEknED3IxvBS7bHnjBSqf ;
    crm:P190_has_symbolic_content """When Allah revealed "And warn your nearest kin" (26:214), the Prophet ﷺ climbed Mount Safa and called each clan of Quraysh by name. He asked, "If I told you an army was behind this hill, would you believe me?" They said, "We have never known you to lie." He said, "Then I am a warner to you of a severe punishment." His uncle Abu Lahab cursed him, and Surah al-Masad was revealed in reply."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:tN1Zs8779iqujx5UkdywMn
    a mrs:Event ;
    rdfs:label """Bilal and "Ahad, Ahad\""""@en ;
    skos:notation 4 ;
    crm:P67i_is_referred_to_by psg:jAlGtUhQStLT1ZwTQ50o2q ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:jAlGtUhQStLT1ZwTQ50o2q
    a mrs:Passage ;
    rdfs:label """Bilal and "Ahad, Ahad\""""@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 4" ;
    skos:notation 4 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:tN1Zs8779iqujx5UkdywMn ;
    crm:P190_has_symbolic_content """Bilal was enslaved by Umayyah ibn Khalaf, who laid him on burning sand at midday with a heavy rock on his chest, demanding he reject Islam. Bilal only repeated, "Ahad, Ahad" (One, One). Abu Bakr bought him and set him free, and went on to free several other tortured believers."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:4ZN7RgKALni3wfwLsgXtXs
    a mrs:Event ;
    rdfs:label "The Family of Yasir"@en ;
    skos:notation 5 ;
    crm:P67i_is_referred_to_by psg:OZGmaSCXeNo1G3aWf6S9HK ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:OZGmaSCXeNo1G3aWf6S9HK
    a mrs:Passage ;
    rdfs:label "The Family of Yasir"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 5" ;
    skos:notation 5 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:4ZN7RgKALni3wfwLsgXtXs ;
    crm:P190_has_symbolic_content """Yasir, his wife Sumayyah and their son Ammar were tortured by Banu Makhzum under Abu Jahl. Passing by, the Prophet ﷺ said, "Patience, O family of Yasir, your promised meeting place is Paradise." Abu Jahl killed Sumayyah with a spear, making her the first martyr of Islam; Yasir also died under torture. When Ammar was forced to say words of disbelief, Allah revealed that one compelled while his heart is firm in faith is excused (16:106)."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

