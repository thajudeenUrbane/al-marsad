    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:zUEu8pjB72CHUJKgyW98sr ;
    crm:P190_has_symbolic_content "The Companions wanted someone to recite the Qur'an aloud to Quraysh. Abdullah ibn Mas'ud, a small man with no powerful clan, volunteered. He stood at the Maqam and recited Surah al-Rahman until Quraysh beat him. He returned bruised and said he was ready to do it again the next day."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:wBWqW0jjsNax6cHsbDUtN7
    a mrs:Event ;
    rdfs:label "Hamzah Accepts Islam"@en ;
    skos:notation 7 ;
    crm:P67i_is_referred_to_by psg:B0Gh2Y3sKKw7PbEvSfwBWQ ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:B0Gh2Y3sKKw7PbEvSfwBWQ
    a mrs:Passage ;
    rdfs:label "Hamzah Accepts Islam"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 7" ;
    skos:notation 7 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:wBWqW0jjsNax6cHsbDUtN7 ;
    crm:P190_has_symbolic_content """Abu Jahl insulted and harmed the Prophet ﷺ near Safa. When Hamzah returned from hunting, a freedwoman told him what had happened. Furious, he went to Abu Jahl at the Ka'bah, struck him with his bow, and declared, "Will you insult him when I follow his religion?" He then embraced Islam fully, and Quraysh became more cautious."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:qpDirF4mMEbFMELFbXuoHk
    a mrs:Event ;
    rdfs:label "Umar ibn al-Khattab Accepts Islam"@en ;
    skos:notation 8 ;
    crm:P67i_is_referred_to_by psg:pZjrq214QXPEZHEKjRpXJf ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:pZjrq214QXPEZHEKjRpXJf
    a mrs:Passage ;
    rdfs:label "Umar ibn al-Khattab Accepts Islam"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 8" ;
    skos:notation 8 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:qpDirF4mMEbFMELFbXuoHk ;
    crm:P190_has_symbolic_content """Umar set out with his sword to kill the Prophet ﷺ. Nu'aym ibn Abdullah told him his own sister had become Muslim. Umar burst into her house, where Khabbab was teaching her and her husband Surah Ta-Ha, and struck her. Seeing her blood and steadfastness, he asked to read the page. Moved, he went to Dar al-Arqam and accepted Islam. The Prophet ﷺ had prayed, "O Allah, strengthen Islam with one of the two Umars." After this, Muslims prayed openly at the Ka'bah."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:DrfxHC5VRV8wg6X6YrmPM1
    a mrs:Event ;
    rdfs:label "Ja'far Before the Negus of Abyssinia"@en ;
    skos:notation 9 ;
    crm:P67i_is_referred_to_by psg:x6dxWbWBJ49zTpoRgAcqKt ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:x6dxWbWBJ49zTpoRgAcqKt
    a mrs:Passage ;
    rdfs:label "Ja'far Before the Negus of Abyssinia"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 9" ;
    skos:notation 9 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:DrfxHC5VRV8wg6X6YrmPM1 ;
    crm:P190_has_symbolic_content "To escape persecution, a group of Muslims migrated to Abyssinia under a just Christian king. Quraysh sent Amr ibn al-As and Abdullah ibn Abi Rabi'ah with gifts to bring them back. Ja'far ibn Abi Talib spoke for the Muslims, describing the ignorance they had left and the truth they had found, then recited from Surah Maryam. The Negus wept and refused to hand them over."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:xW6NEHXLvY2ewLlBku5CK1
    a mrs:Event ;
    rdfs:label "The Boycott in Shi'b Abi Talib"@en ;
    skos:notation 10 ;
    crm:P67i_is_referred_to_by psg:ElVgnzAzPab1UULQqtDAkn ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:ElVgnzAzPab1UULQqtDAkn
    a mrs:Passage ;
    rdfs:label "The Boycott in Shi'b Abi Talib"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 10" ;
    skos:notation 10 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:xW6NEHXLvY2ewLlBku5CK1 ;
    crm:P190_has_symbolic_content """Quraysh hung a pact in the Ka'bah to boycott Banu Hashim and Banu al-Muttalib: no trade, no marriage. For about three years the Prophet ﷺ and his family were confined to a valley, surviving on leaves and scraps. Some sympathetic Qurayshis worked to end it, and the document was found eaten by termites except for the words "In Your name, O Allah," just as the Prophet ﷺ had said."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:xGSpcMGjRekcCkj3q6jQ1N
    a mrs:Event ;
    rdfs:label "The Journey to Ta'if"@en ;
    skos:notation 11 ;
    crm:P67i_is_referred_to_by psg:jgkmB33kp7AkVdIgqIDFH8 ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:jgkmB33kp7AkVdIgqIDFH8
    a mrs:Passage ;
    rdfs:label "The Journey to Ta'if"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 11" ;
    skos:notation 11 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:xGSpcMGjRekcCkj3q6jQ1N ;
    crm:P190_has_symbolic_content """After the deaths of Abu Talib and Khadijah in the Year of Sorrow, the Prophet ﷺ walked to Ta'if to invite Thaqif. Its leaders rejected him and set youths to stone him until his feet bled. Resting in a garden, he made his famous supplication. The angel of the mountains offered to crush the town, but he said, "I hope Allah will bring from their descendants people who worship Him alone." A Christian servant named Addas brought him grapes and believed."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:WDZd7t0kAE8mQaZW9PVsA4
    a mrs:Event ;
    rdfs:label "Al-Isra wal-Mi'raj"@en ;
    skos:notation 12 ;
    crm:P67i_is_referred_to_by psg:VP8TXfv6IenMxI39DjtmwT ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:VP8TXfv6IenMxI39DjtmwT
    a mrs:Passage ;
    rdfs:label "Al-Isra wal-Mi'raj"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 12" ;
    skos:notation 12 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:WDZd7t0kAE8mQaZW9PVsA4 ;
    crm:P190_has_symbolic_content """In one night the Prophet ﷺ was taken from Makkah to Jerusalem, where he led the prophets in prayer, then ascended through the heavens, where the five daily prayers were prescribed. When he told Quraysh, they mocked him and ran to Abu Bakr. Abu Bakr said, "If he said it, it is true," earning the title al-Siddiq."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:wEnsp7vZyAhD2eQt5eER0q
    a mrs:Event ;
    rdfs:label "The Pledges of Aqabah"@en ;
    skos:notation 13 ;
    crm:P67i_is_referred_to_by psg:ytYCq8ztgSIQrC10Y9KNjJ ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:ytYCq8ztgSIQrC10Y9KNjJ
    a mrs:Passage ;
    rdfs:label "The Pledges of Aqabah"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 1, story 13" ;
    skos:notation 13 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:TaAnZywAx5YqdQkyD7OE9M ;
    crm:P67_refers_to ev:wEnsp7vZyAhD2eQt5eER0q ;
    crm:P190_has_symbolic_content "In the pilgrimage seasons, groups from Yathrib met the Prophet ﷺ at Aqabah. Twelve pledged in the first year, and he sent Mus'ab ibn Umayr back with them as teacher. Through Mus'ab, the chiefs Sa'd ibn Mu'adh and Usayd ibn Hudayr accepted Islam. The next year seventy-three men and two women pledged to protect him as they would their own families, opening the way to the Hijrah."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:wMdngvzQBtlbC6EyKySQg8
    a mrs:Event ;
    rdfs:label "The Hijrah and the Cave of Thawr"@en ;
    skos:notation 14 ;
    crm:P67i_is_referred_to_by psg:u9CoOpl3eeXUPZBGg4RrGF ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:u9CoOpl3eeXUPZBGg4RrGF
    a mrs:Passage ;
    rdfs:label "The Hijrah and the Cave of Thawr"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 2, story 14" ;
    skos:notation 14 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:DSncW76DyVfu99HiqYpybA ;
    crm:P67_refers_to ev:wMdngvzQBtlbC6EyKySQg8 ;
    crm:P190_has_symbolic_content """Quraysh plotted to kill the Prophet ﷺ in his bed. Ali slept in his place under his green cloak, and the Prophet ﷺ left with Abu Bakr for the Cave of Thawr. When the trackers stood at its mouth, Abu Bakr whispered his fear, and the Prophet ﷺ said, "What do you think of two when Allah is the third?" (9:40). After three days they set out for Madinah. Suraqah ibn Malik chased them for the bounty, but his horse's legs sank into the sand three times; he asked for safety and was promised the bracelets of Kisra."""@en ;
    skos:note "Abdullah ibn Urayqit, their hired guide, was not a Muslim at the time."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:2JeuHTYYSbGuzG3AYEnohp
    a mrs:Event ;
    rdfs:label "Arrival in Madinah and the Building of the Mosque"@en ;
    skos:notation 15 ;
    crm:P67i_is_referred_to_by psg:OgY5C24TrH8Pg4AZ2us2dV ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:OgY5C24TrH8Pg4AZ2us2dV
    a mrs:Passage ;
    rdfs:label "Arrival in Madinah and the Building of the Mosque"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 2, story 15" ;
    skos:notation 15 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:DSncW76DyVfu99HiqYpybA ;
    crm:P67_refers_to ev:2JeuHTYYSbGuzG3AYEnohp ;
    crm:P190_has_symbolic_content """The people of Madinah went out every morning to wait for the Prophet ﷺ. When he arrived, children sang, and every family wanted to host him. He let his camel walk freely, saying "She is commanded." She knelt by a plot owned by two orphans, and he stayed at the nearby house of Abu Ayyub. The land was bought, and the Prophet ﷺ carried bricks alongside his Companions to build the mosque."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:hN8HDx1Y9ICzmFKejALLxD
    a mrs:Event ;
    rdfs:label "The Brotherhood of the Muhajirun and Ansar"@en ;
    skos:notation 16 ;
    crm:P67i_is_referred_to_by psg:vLkNQ6TU7pKNrnxCM1kExG ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:vLkNQ6TU7pKNrnxCM1kExG
    a mrs:Passage ;
    rdfs:label "The Brotherhood of the Muhajirun and Ansar"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 2, story 16" ;
    skos:notation 16 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:DSncW76DyVfu99HiqYpybA ;
    crm:P67_refers_to ev:hN8HDx1Y9ICzmFKejALLxD ;
    crm:P190_has_symbolic_content """The Prophet ﷺ paired each emigrant from Makkah with a helper from Madinah as brothers. Sa'd ibn al-Rabi' offered Abd al-Rahman ibn Awf half his wealth. Abd al-Rahman thanked him and said, "Just show me the way to the market." He traded and soon prospered."""@en ;
    skos:note "The pairings listed follow Ibn Ishaq and Ibn Sa'd; some lists differ."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:KTEo1xOHS1eREM8TEkYkgR
    a mrs:Event ;
    rdfs:label "Salman al-Farisi's Search for Truth"@en ;
    skos:notation 17 ;
    crm:P67i_is_referred_to_by psg:s9nC9vAhnCNQfUAwnAna9f ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:s9nC9vAhnCNQfUAwnAna9f
    a mrs:Passage ;
    rdfs:label "Salman al-Farisi's Search for Truth"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 2, story 17" ;
    skos:notation 17 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:DSncW76DyVfu99HiqYpybA ;
    crm:P67_refers_to ev:KTEo1xOHS1eREM8TEkYkgR ;
    crm:P190_has_symbolic_content "Salman was born a Zoroastrian in Persia. Drawn to Christianity, he served a series of monks; the last told him a prophet would appear in a land of palms, who would accept gifts but not charity and carry the seal of prophethood between his shoulders. Sold into slavery in Madinah, he tested the Prophet ﷺ on all three signs and accepted Islam. The Prophet ﷺ helped him buy his freedom by planting 300 palm saplings with his own hands."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:0wLFxgTdjKzC8bdJcdrEXV
    a mrs:Event ;
    rdfs:label "The First Adhan"@en ;
    skos:notation 18 ;
    crm:P67i_is_referred_to_by psg:2gu1EzCnwgoRrgkhL8w72n ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:2gu1EzCnwgoRrgkhL8w72n
    a mrs:Passage ;
    rdfs:label "The First Adhan"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 2, story 18" ;
    skos:notation 18 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:DSncW76DyVfu99HiqYpybA ;
    crm:P67_refers_to ev:0wLFxgTdjKzC8bdJcdrEXV ;
    crm:P190_has_symbolic_content """The Muslims discussed how to gather people for prayer: a bell, a horn or a fire. Abdullah ibn Zayd saw the words of the adhan in a dream. The Prophet ﷺ said, "It is a true vision. Teach it to Bilal, for his voice is stronger." When Umar heard Bilal, he ran out saying he had seen the same dream."""@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:5y2oDtY57yVcVjYyNFUw7m
    a mrs:Event ;
    rdfs:label "Abdullah ibn Salam Accepts Islam"@en ;
    skos:notation 19 ;
    crm:P67i_is_referred_to_by psg:3Y5Pkwy9bpaiLLT0grMgQy ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

psg:3Y5Pkwy9bpaiLLT0grMgQy
    a mrs:Passage ;
    rdfs:label "Abdullah ibn Salam Accepts Islam"@en ;
    mrs:canonicalCitation "50 Stories (rev 7), Part 2, story 19" ;
    skos:notation 19 ;
    mrs:inWitness wit:SfERCK2TeJUtCZL9VuJnPH ;
    dct:isPartOf psg:DSncW76DyVfu99HiqYpybA ;
    crm:P67_refers_to ev:5y2oDtY57yVcVjYyNFUw7m ;
    crm:P190_has_symbolic_content "Abdullah ibn Salam, a leading Jewish scholar of Madinah, asked the Prophet ﷺ three questions only a prophet would know, and was satisfied. Before announcing his Islam, he hid while the Prophet ﷺ asked his community about him. They called him their best and son of their best. When he came out and declared his faith, they called him their worst."@en ;
    mrs:coverageState mrs:cs_stub ;
    mrs:createdBy agt:99lfWZ9Al5KAc3YUZNakNh ;
    mrs:recordedAt "2026-10-15T00:00:00Z"^^xsd:dateTime .

ev:oPlPpUrWs3Ruu3vusLUPv0
    a mrs:Event ;
    rdfs:label "The Battle of Badr"@en ;
    skos:notation 20 ;
    crm:P67i_is_referred_to_by psg:pBkRGfgyATxirfE9P8IhIK ;
